---
import BaseLayout from "@/layouts/BaseLayout.astro";

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const apiUrl = import.meta.env.PUBLIC_CONTACT_API_URL;
---

<BaseLayout title="Uriel Federez" showTitleInHeader={false}>
  <main class="px-10 flex flex-col gap-12">
    <div class="grid gap-4 grid-cols-2">
      <div class="flex flex-col gap-4">
        <h2 class="text-6xl font-bold">Uriel Federez</h2>
        <p class="text-2xl font-light max-w-[35ch]">
          I'm a software engineer working across the full stack, exploring
          computer graphics and systems programming. Here I document the things
          I build and what I learn along the way.
        </p>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <section class="basis-3/4 flex flex-col gap-3">
        <h3 class="uppercase tracking-widest text-gray-600 text-sm">
          Selected Work
        </h3>
        <div class="grid grid-cols-3 gap-5">
          <div>
            <h4 class="text-xl font-bold">Subrosa</h4>
            <p class="font-light">
              Chess engine built with Zig. Playable online
            </p>
            <div class="w-full aspect-video bg-gray-300"></div>
          </div>
          <div>
            <h4 class="text-xl font-bold">Volume Renderer</h4>
            <p class="font-light">3D visualization of MRIs and CT scans.</p>
            <div class="w-full aspect-video bg-gray-300"></div>
          </div>
          <div>
            <h4 class="text-xl font-bold">Raytracer</h4>
            <p class="font-light">
              Multithreaded raytracer to render more realistic scenery
            </p>
            <div class="w-full aspect-video bg-gray-300"></div>
          </div>
        </div>
      </section>
      <section class="basis-1/4 flex flex-col gap-3">
        <h3 class="uppercase tracking-widest text-gray-600 text-sm">
          Articles
        </h3>
        <div>
          <h4 class="text-xl font-bold">Wrapping my head around bitboards</h4>
          <p>
            Documenting my process for understanding and implementing the board
            representation in my chess engine.
          </p>
          <p class="font-light text-xs">Oct 18, 2026</p>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
