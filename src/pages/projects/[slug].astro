---
import ArticleCard from "@/components/ArticleCard.astro";
import { LinkButton } from "@/components/ui/LinkButton";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ExternalLink } from "@lucide/astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

export const getStaticPaths = async () => {
  const projects = await getCollection("projects");

  return Promise.all(
    projects.map(async (project) => ({
      params: { slug: project.id },
      props: { project },
    })),
  );
};

const { project } = Astro.props;

const articles = await getCollection(
  "articles",
  ({ data }) =>
    (import.meta.env.DEV || !data.isDraft) && data.project?.id === project.id,
);

const { Content } = await render(project);
---

<BaseLayout title={project.data.title} mainClassName="max-w-6xl">
  <div class="grid gap-4 grid-cols-2 items-center">
    <div class="flex flex-col gap-4">
      <h1 class="text-6xl font-bold max-w-[16ch]">{project.data.title}</h1>
      <p>Status: {project.data.status}</p>

      <!-- <ul>
          {project.data.technologies.map((technology) => <li>{technology}</li>)}
        </ul> -->

      <p class="text-xl font-light max-w-[40ch] leading-7 whitespace-pre-line">
        {project.data.description}
      </p>

      <div class="flex">
        {
          project.data.repository && (
            <LinkButton href={project.data.repository} target="_blank">
              Source code
              <ExternalLink class="text-sm size-4" />
            </LinkButton>
          )
        }
      </div>
    </div>
    <Image
      src={project.data.showcase}
      alt={`${project.data.title} showcase`}
      class="aspect-square w-full object-cover object-top-left"
    />
  </div>

  <hr class="mt-12 border-t border-gray-300" />

  <div class="max-w-xl mx-auto mt-6 grid gap-6">
    <article
      class="prose prose-lg prose-neutral max-w-none
                prose-headings:tracking-tight
                prose-a:text-blue-600
                prose-pre:rounded-xl"
    >
      <Content />
    </article>
    {articles.map((article) => <ArticleCard article={article} />)}
  </div>
</BaseLayout>
