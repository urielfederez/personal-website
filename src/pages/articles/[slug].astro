---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export const getStaticPaths = async () => {
  const articles = await getCollection("articles");

  return Promise.all(
    articles.map(async (article) => ({
      params: { slug: article.id },
      props: { article },
    })),
  );
};

const { article } = Astro.props;
const { Content } = await render(article);

const dateLabel = article.data.date.toLocaleDateString("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={article.data.title}>
  <main class="flex flex-col w-full max-w-6xl mx-auto">
    <div class="flex flex-col gap-6 items-stretch">
      <div class="max-w-xl mx-auto">
        <h1 class="text-5xl font-bold leading-tight">{article.data.title}</h1>
        <time class="text-sm text-gray-600">{dateLabel}</time>
      </div>
      <article
        class="prose prose-lg prose-neutral max-w-none
                prose-headings:tracking-tight
                prose-a:text-blue-600
                prose-pre:rounded-xl
                article-content"
      >
        <Content />
      </article>
    </div>
  </main>
</BaseLayout>
