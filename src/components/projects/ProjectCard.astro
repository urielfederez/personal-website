---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
  project: CollectionEntry<"projects">;
};

const {
  project: {
    data: { title, shortDescription, showcase },
    ...project
  },
} = Astro.props;
const href = `/projects/${project.id}`;
---

<article class="group">
  <a href={href} class="group-hover:underline">
    <h4 class="text-xl font-bold">{title}</h4>
  </a>
  <p class="font-light">{shortDescription}</p>
  <a href={href} class="peer">
    <Image
      src={showcase}
      alt=""
      class="aspect-square w-full object-cover object-left"
      quality={80}
    />
  </a>
</article>
